# ───────── CORE APPLICATION ─────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ───────── DATABASE & CACHE ─────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/xavanxai?schema=public
REDIS_URL=redis://localhost:6379

# ───────── AUTHENTICATION ─────────
# Generate with:  openssl rand -base64 48     (min 32 chars in production)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───────── SEED (optional, used by `npm run db:seed`) ─────────
INITIAL_ADMIN_EMAIL=admin@xavanxai.com
INITIAL_ADMIN_PASSWORD=

# ───────── AI & VOICE PROVIDERS (SERVER-SIDE ONLY) ─────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# ───────── STORAGE (private S3 / Cloudflare R2 for CVs) ─────────
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ───────── EMAIL & AUTOMATION ─────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
N8N_WEBHOOK_SECRET=
N8N_BOOKING_WEBHOOK_URL=
N8N_OUTBOUND_WEBHOOK_URL=
